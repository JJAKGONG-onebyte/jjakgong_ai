# 메인 서버(Spring)와 같은 값을 써야 하는 항목
FOCUS_STREAM_SECRET=change-me-to-a-random-string-at-least-32-bytes
INTERNAL_API_KEY=local-test-key
MAIN_SERVER_URL=http://localhost:8080

# server: AI 서버 수신 시각 기준 (운영) / client: 브라우저 timestamp 기준 (시뮬레이터 빠른 재생용)
TIME_SOURCE=server

# 특징값 로그 저장 폴더. 비우면 저장하지 않음
FEATURE_LOG_DIR=data/raw
